# Copy to .env and adjust as needed. docker-compose.yml and the Aspire AppHost
# already provide working defaults for local dev; this file documents what's
# configurable and is a starting point for values you inject yourself.

# --- Api (src/Api) ---
ConnectionStrings__Postgres=Host=localhost;Database=meridian;Username=postgres;Password=postgres
Keycloak__Authority=http://localhost:8080/realms/meridian
Keycloak__Audience=meridian-api

# --- Redis (reserved for caching / rate limiting in later tickets) ---
Redis__ConnectionString=localhost:6379

# --- web (Vite build-time vars, see web/.env.example) ---
VITE_API_BASE_URL=http://localhost:5299
VITE_KEYCLOAK_AUTHORITY=http://localhost:8080/realms/meridian
VITE_KEYCLOAK_CLIENT_ID=meridian-web

# --- Keycloak dev admin console (docker-compose only) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
