# Copy this file to .env and fill in real values as you need them.
# None of these are required to run `pnpm dev`, `pnpm build`, or `pnpm test` —
# the current scaffold boots and its sample module/tests pass with no
# third-party credentials present. Third-party SDKs are initialized lazily,
# not at import time, so their absence never blocks a boot.

# PostgreSQL connection string (Neon in production, local Postgres in dev).
# Only needed once you run `prisma migrate dev` / `prisma db push` against a
# real database — `prisma validate`/`generate` do not need it.
DATABASE_URL="postgresql://user:password@localhost:5432/meridian?schema=public"

# Auth.js session/JWT secret (standard email/OAuth login).
AUTH_SECRET=""

# WorkOS — scoped to enterprise SSO/SCIM only (MLP-41/MLP-42), not app-wide auth.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""

# Inngest — background jobs (invoice ingestion, tracking polls, freight audit,
# notifications).
INNGEST_EVENT_KEY=""

# Ably — realtime upgrade path once Postgres LISTEN/NOTIFY outgrows MVP scale
# (see docs/adr/0001-tech-stack.md). Not used yet.
ABLY_API_KEY=""
