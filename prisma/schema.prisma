// Prisma schema for the Meridian Logistics Platform.
// See docs/adr/0001-tech-stack.md for the stack decision this implements.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Placeholder model proving the schema is valid and generates a client.
model HealthCheck {
  id        String   @id @default(cuid())
  checkedAt DateTime @default(now())
}

// MLP-18: Single Shipment Creation

enum ServiceLevel {
  STANDARD
  EXPEDITED
  GUARANTEED
}

enum ShipmentStatus {
  DRAFT
  SUBMITTED
}

model Location {
  id           String   @id @default(cuid())
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  region       String
  postalCode   String
  country      String
  createdAt    DateTime @default(now())

  originFor      Shipment[] @relation("ShipmentOrigin")
  destinationFor Shipment[] @relation("ShipmentDestination")
}

model Shipment {
  id                     String         @id @default(cuid())
  status                 ShipmentStatus @default(DRAFT)
  originId               String?
  origin                 Location?      @relation("ShipmentOrigin", fields: [originId], references: [id])
  destinationId          String?
  destination            Location?      @relation("ShipmentDestination", fields: [destinationId], references: [id])
  weightLbs              Float?
  lengthIn               Float?
  widthIn                Float?
  heightIn               Float?
  freightClass           String?
  serviceLevel           ServiceLevel?
  isHazmat               Boolean        @default(false)
  hazmatUnNumber         String?
  hazmatPackingGroup     String?
  hazmatEmergencyContact String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}
